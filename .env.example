# Prevue Environment Configuration Template
# Copy this file to .env and fill in your real credentials
#
# Note: the YouTube Data API key and Gemini API key are configured on the
# backend only (see server/.env.example) — the mobile app never holds them.
# BACKEND_API_BASE_URL points the app at the Prevue backend's versioned API
# root, e.g. http://localhost:3000/api/v1 for local development.
BACKEND_API_BASE_URL=http://localhost:3000/api/v1

# RevenueCat In-App Purchases Public API Keys
# Get from: https://app.revenuecat.com -> Project Settings -> API Keys
REVENUECAT_APPLE_API_KEY=appl_YOUR_REVENUECAT_APPLE_KEY_HERE
REVENUECAT_GOOGLE_API_KEY=goog_YOUR_REVENUECAT_GOOGLE_KEY_HERE
