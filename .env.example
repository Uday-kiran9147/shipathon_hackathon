# TubeSimul8 Environment Configuration Template
# Copy this file to .env and fill in your real credentials

# Google Cloud YouTube Data API v3 Key
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
YOUTUBE_API_KEY=AIzaSy_YOUR_YOUTUBE_API_KEY_HERE

# RevenueCat In-App Purchases Public API Keys
# Get from: https://app.revenuecat.com -> Project Settings -> API Keys
REVENUECAT_APPLE_API_KEY=appl_YOUR_REVENUECAT_APPLE_KEY_HERE
REVENUECAT_GOOGLE_API_KEY=goog_YOUR_REVENUECAT_GOOGLE_KEY_HERE

# Google Gemini API Key (Multimodal Intelligence)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
