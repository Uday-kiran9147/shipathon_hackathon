# -------------------------------------------------------------------
# Prevue Server: Environment Configuration Example
# -------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# PostgreSQL + pgvector Database Connection String
DATABASE_URL=postgresql://neondb_owner:...@ep-...neon.tech/Prevue?sslmode=verify-full

# Google Gemini API Key (text-embedding-004 & Gemini 3.7 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# RevenueCat Secret Key (V2 API & Webhooks)
REVENUECAT_SECRET_KEY=your_revenuecat_secret_key_here
