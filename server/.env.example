# Prevue Creator Intelligence - Environment Configuration
# Copy this file to .env (for Flutter app and server) and .env.production (for server deployment)

# -------------------------------------------------------------
# 1. Flutter Mobile App Configuration
# -------------------------------------------------------------
# When running on Android Emulator: http://10.0.2.2:3000/api/v1
# When running on physical device over Wi-Fi: http://<YOUR_LOCAL_IP>:3000/api/v1
# When deployed to cloud production: https://api.yourdomain.com/api/v1
BACKEND_API_BASE_URL=http://10.0.2.2:3000/api/v1

# RevenueCat In-App Purchases Public SDK API Keys
REVENUECAT_APPLE_API_KEY=appl_mock_prevue_apple_key
REVENUECAT_GOOGLE_API_KEY=goog_mock_prevue_google_key

# -------------------------------------------------------------
# 2. Prevue NestJS Backend Server Configuration
# -------------------------------------------------------------
PORT=3000
NODE_ENV=production

# YouTube Data API v3 Key (Required for live YouTube Channel & Video Sync)
# Get key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Google Gemini API Key (Required for AI Prescriptive Briefings & Vector Embeddings)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# PostgreSQL Database URL with pgvector (Optional / Best-effort)
# e.g., postgresql://username:password@localhost:5432/prevue_db
DATABASE_URL=

# RevenueCat Secret REST API Key (Optional / Backend Webhook Sync)
REVENUECAT_SECRET_KEY=
