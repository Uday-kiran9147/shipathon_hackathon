{
  "name": "prevue-server",
  "version": "1.0.0",
  "description": "Prevue: YouTube Creator Intelligence, Vector Search & Pre-Flight Simulator Backend (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main",
    "env:encode": "node scripts/generate-env.js --encode",
    "env:decode": "node scripts/generate-env.js --decode"
  },
  "keywords": [
    "youtube",
    "intelligence",
    "pgvector",
    "simulator",
    "revenuecat",
    "gemini",
    "nestjs"
  ],
  "author": "Prevue Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@types/cors": "^2.8.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "pg": "^8.11.5",
    "pgvector": "^0.1.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^10.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
